# --- Servidor ---
PORT=8080
LOG_LEVEL=info
PUBLIC_BASE_URL=

# --- Infodesk (docs/infodesk/) ---
# Raiz da API de integração; a chave é o Bearer (escopos tickets:* e conversations:*).
INFODESK_BASE_URL=https://infodesk.infominas.net/api/integration/v1
INFODESK_API_KEY=
# HMAC-SHA256 do corpo cru do webhook (X-Infominas-Signature: sha256=...).
# Mínimo de 32 caracteres fora do dev; vazio: o gateway não sobe (só com
# WEBHOOK_SEM_AUTENTICACAO=true, em dev). Opcionalmente também ?token=... na URL.
INFODESK_WEBHOOK_SECRET=
WEBHOOK_TOKEN=
# Se preenchido, webhook de outra organização é recusado (multi-tenant).
INFODESK_ORGANIZATION_ID=
INFODESK_TIMEOUT=15s
# Cache de mesas/departamentos/atendentes (GET /desks, /departments, /users).
REFERENCIA_CACHE_TTL=10m
# Departamento do Infodesk que recebe a conversa transferida pelo bot quando a
# taxonomia não aponta outro. Vazio = avisa o cliente e registra, mas não move.
DEPARTAMENTO_HUMANO_PADRAO=

# --- Lista de testadores (E3.9; homologação em produção) ---
# Telefones E.164 separados por vírgula (com ou sem +55, com ou sem o 9º dígito).
# VAZIO = desligada: todo cliente fala com a Sofia. Preenchida: SÓ esses números
# falam com ela; os demais vão direto a um atendente (handoff para
# DEPARTAMENTO_HUMANO_PADRAO), sem resposta ao cliente. Com a flag "Conduz o
# atendimento" da chave ligada e esta lista VAZIA, todos os clientes caem na Sofia.
# Item que não é telefone derruba o boot. Ver docs/plano/operacao.md.
TESTADORES_TELEFONES=
# Lista vazia só sobe com SOFIA_PRODUCAO_ABERTA=true (opt-in explícito: todo cliente
# fala com a Sofia). Em dev (Infodesk local) não é exigido.
SOFIA_PRODUCAO_ABERTA=false
# Só dev: deixa o gateway subir sem INFODESK_WEBHOOK_SECRET (webhook sem HMAC).
WEBHOOK_SEM_AUTENTICACAO=false

# --- Gateway: horário de atendimento humano (E5.5; hipótese de trabalho, P7) --
# Fora do horário a Sofia segue atendendo e abrindo chamado; só a transferência
# muda: o handoff continua (a conversa cai na fila) e o aviso ao cliente diz que a
# equipe atende no horário abaixo e que a conversa fica registrada. Formato: dias +
# faixas, várias entradas separadas por `;` (ex.: "seg-sex 08:00-18:00; sab 08:00-12:00";
# várias faixas no dia: "seg-sex 08:00-12:00,14:00-18:00"; fim menor que o início
# atravessa a meia-noite). Default = expediente das mesas do Desk. VAZIO (HORARIO_HUMANO=)
# = sempre dentro do horário. TODO(P7): confirmar que vale para o WhatsApp.
HORARIO_HUMANO="seg-sex 08:00-18:00"
# Fuso do horário e dos feriados (nome IANA).
HORARIO_FUSO=America/Sao_Paulo
# Feriados (AAAA-MM-DD, separados por vírgula): o dia inteiro conta como fora do horário.
FERIADOS=
# avisar (default): fora do horário o aviso ao cliente é o de fora do horário.
# ignorar: aviso normal (a nota do handoff e o log seguem marcados "fora do horário").
FORA_DO_HORARIO_MODO=avisar

# --- Gateway: limites de abuso (E4.5; defaults folgados) ----------------------
# Teto de caracteres do texto coalescido de uma rajada que vai ao cérebro.
LOTE_MAX_CHARS=4000
# Turnos por telefone por hora; acima disso a conversa vai a um atendente.
TURNOS_POR_HORA_MAX=60

# --- Cérebro Python (Contrato A, POST /chat) ---
BRAIN_BASE_URL=http://localhost:8001
# Ordem dos prazos (checada no boot): TURNO_TETO >= DEBOUNCE_TETO + BRAIN_TIMEOUT.
# O TURNO_TETO conta desde a PRIMEIRA mensagem da rajada, então a coalescência
# (DEBOUNCE_TETO) consome parte dele antes de o cérebro ser chamado. BRAIN_TIMEOUT
# (por chamada ao cérebro) precisa ser maior que o BRAIN_TURNO_PRAZO do cérebro
# (70s) — o gateway não o conhece; o cérebro confere do lado dele.
BRAIN_TIMEOUT=80s
# Teto do turno desde a mensagem do cliente (coalescência + cérebro + novas
# tentativas em falha transitória: 2 s e 5 s). Falha definitiva não repete.
# Com estes valores a nova tentativa só cabe quando a rajada foi curta.
TURNO_TETO=105s

# --- Robustez de transporte (laudo 2026-08-27) ---
# Coalescência: silêncio que fecha uma rajada de mensagens do cliente — a
# rajada inteira vira UM turno (F11: sem turnos concorrentes por conversa).
DEBOUNCE_JANELA=8s
# Espera máxima acumulada antes de processar mesmo sem silêncio.
DEBOUNCE_TETO=20s
# Mensagens mais velhas que isso são descartadas (F10).
EVENTO_IDADE_MAX=10m
# Tamanho-alvo de cada mensagem enviada ao WhatsApp; respostas maiores são
# divididas em partes (F12). 0 = sem quebra.
REPLY_MAX_CHARS=900
# Pausa entre bolhas consecutivas do mesmo turno (o cérebro marca as bolhas
# com uma linha "---"; cada uma vira uma mensagem). Ritmo humano; 0 = sem pausa.
BOLHA_PAUSA=1500ms

# --- Alertas ao responsável ---
# Sempre no log `sofia_alerta`; opcionalmente POST JSON {"text": ...} aqui.
ALERTA_WEBHOOK_URL=

# --- Persistência ---
# PG_URL preenchido = Postgres (o MESMO do RAG/pgvector; o gateway cria e usa
# o schema `gateway`). Vazio = SQLite local em DB_PATH (dev sem Postgres).
PG_URL=
DB_PATH=gateway.db

# --- API de tools (/tools/infodesk/*) que o cérebro chama ---
# Segredo compartilhado cérebro↔gateway (header X-Tools-Token). Vazio = a API
# não é exposta. Mínimo de 32 caracteres fora do dev.
TOOLS_API_TOKEN=
