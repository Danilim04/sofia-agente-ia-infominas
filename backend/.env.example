# --- Servidor ---
PORT=8080
LOG_LEVEL=info
PUBLIC_BASE_URL=

# --- Chatwoot ---
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
# Autenticação do webhook: use um dos dois (token na URL ?token=... OU HMAC).
WEBHOOK_TOKEN=
WEBHOOK_SECRET=

# --- Etiquetas (gate de borda / roteamento) ---
# LABEL_BOT vazio = processa toda mensagem de entrada do contato.
LABEL_BOT=fila-bot
LABEL_HUMANO=fila-humano

# --- Mongo da Azapfy (lookup de usuário por login — a 1ª tool) ---
MONGO_URI=
MONGO_DB=azapfy
MONGO_COLLECTION=users
MONGO_TIMEOUT=8s

# --- Cérebro Python (Contrato A, POST /chat) ---
BRAIN_BASE_URL=http://localhost:8001
BRAIN_TIMEOUT=60s

# --- Identidade / gate ---
# Dado pedido na confirmação anti-impersonação: email (default) | nome
CONFIRM_FIELD=email
MAX_TENTATIVAS=3
IDENTITY_TTL=24h
# Após esse tempo, uma conversa em "falha" (3 tentativas / roteada a humano)
# volta a ser atendida pelo bot — a identificação recomeça (fix F1: o estado
# de falha não é mais terminal). É só rede de segurança: a conversa RESOLVIDA
# no Chatwoot tem o estado do gate apagado na hora (conversation_updated).
GATE_FALHA_TTL=1h

# --- Robustez de transporte (laudo 2026-08-27) ---
# Coalescência: silêncio que fecha uma rajada de mensagens do cliente — a
# rajada inteira vira UM turno (F11: sem turnos concorrentes por conversa).
DEBOUNCE_JANELA=8s
# Espera máxima acumulada antes de processar mesmo sem silêncio.
DEBOUNCE_TETO=20s
# Mensagens mais velhas que isso (re-sync do relay) são descartadas (F10).
EVENTO_IDADE_MAX=10m
# Tamanho-alvo de cada mensagem enviada ao WhatsApp; respostas maiores são
# divididas em partes (F12). 0 = sem quebra.
REPLY_MAX_CHARS=900
# Pausa entre bolhas consecutivas do mesmo turno (o cérebro marca as bolhas
# com uma linha "---"; cada uma vira uma mensagem). Ritmo humano; 0 = sem pausa.
BOLHA_PAUSA=1500ms

# --- Persistência ---
# PG_URL preenchido = Postgres (o MESMO do RAG/pgvector; o gateway cria e usa
# o schema `gateway`). Vazio = SQLite local em DB_PATH (dev sem Postgres).
PG_URL=
DB_PATH=gateway.db

# --- SAC / chamados (tools de dados que o cérebro chama via /tools/sac/*) ---
# Opcional: sem SAC_BASE_URL a API de tools não é exposta. Sem TOOLS_API_TOKEN
# ela também não sobe (segredo compartilhado cérebro↔gateway, header X-Tools-Token).
SAC_BASE_URL=
SAC_PORTAL_URL=https://atendimento.azapfy.com.br
# Login privilegiado (SAC/super/GESTOR) que passa no IdentificaUsuario do SAC e
# permite definir a prioridade via /incidente/editar. Vazio = chamado nasce sem
# prioridade (atendente triagem); a criação continua funcionando.
SAC_SERVICE_COD=
SAC_GRUPO_EMP=AZAPERS
SAC_EMPRESA=AZAPFY
SAC_TIMEZONE=America/Sao_Paulo
SAC_API_TOKEN=
SAC_CONFIG_TTL=10m
TOOLS_API_TOKEN=
