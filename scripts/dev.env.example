# dev.env.example — variáveis de dev lidas por scripts/start-all.sh.
#
# NENHUM SEGREDO AQUI: só valores de dev que casam mock-infodesk, gateway e
# cérebro entre si. Para ajustar, copie para scripts/dev.env (ignorado pelo
# git, ver scripts/.gitignore) e edite lá:
#
#     cp scripts/dev.env.example scripts/dev.env
#
# Chaves reais (OPENROUTER_API_KEY, TYPESAFE_API_KEY, Langfuse) ficam em
# agente-ia/.env — também fora do git — ou no ambiente do shell. Não as ponha
# neste arquivo de exemplo.
#
# Formato: CHAVE=valor, uma por linha (sem `export`, sem expansão de $VAR).
# Valor vazio é ignorado. O ambiente do shell vence o arquivo:
#     MOCK_PORT=9100 scripts/start-all.sh

# --- Portas -----------------------------------------------------------------
BRAIN_PORT=8001
BACKEND_PORT=8080
MOCK_PORT=9000
# Chainlit (agente-ia/app.py), só com scripts/start-all.sh --chainlit
CHAINLIT_PORT=8000

# --- Cola mock-infodesk <-> gateway <-> cérebro ------------------------------
# O script força INFODESK_API_KEY / INFODESK_WEBHOOK_SECRET / INFODESK_BASE_URL
# do gateway e INFODESK_TOOLS_* do cérebro a partir destes valores.
MOCK_API_KEY=ik_test_mock
MOCK_WEBHOOK_SECRET=segredo-mock
MOCK_ORG_ID=44444444-4444-4444-8444-444444444401
# Segredo cérebro <-> gateway (X-Tools-Token): valor de dev, não é segredo.
TOOLS_API_TOKEN=dev-token

# --- Taxonomia de dev (P1 em aberto) ----------------------------------------
# Mesas e departamentos do mock-infodesk, NÃO o mapeamento real da Infominas.
# Relativo à raiz do repositório; o script converte para caminho absoluto.
# Cérebro e gateway leem o mesmo arquivo. Sem esta linha, o gateway usa o
# placeholder versionado (agente-ia/config/taxonomia.yaml) e quase toda
# categoria vira `categoria_sem_mapa` contra as mesas do mock.
TAXONOMIA_PATH=scripts/dev/taxonomia.dev.yaml
# true = o gateway não sobe se a taxonomia divergir das mesas do mock.
STRICT_TAXONOMIA=true
# Departamento que recebe a conversa transferida (existe em dados.json). O
# gateway lê ESTA variável, não o departamento_humano_padrao da taxonomia:
# mantenha os dois iguais.
DEPARTAMENTO_HUMANO_PADRAO=Atendimento

# --- Ritmo de dev (o gateway demora menos para responder) -------------------
DEBOUNCE_JANELA=2s
DEBOUNCE_TETO=6s
BOLHA_PAUSA=300ms

# --- Logs --------------------------------------------------------------------
LOG_LEVEL=info

# --- Opcionais do mock (descomente para exercitar) ---------------------------
# MOCK_429_A_CADA=10
# MOCK_SEM_REENTREGA=1
