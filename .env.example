# ==============================================================================
# .env ÚNICO da stack docker (raiz) — alimenta brain + gateway via compose.
#
# Dev local:  cp .env.example .env  e preencha os "troque-aqui".
# Produção:   NÃO editar na VPS — o arquivo inteiro é renderizado pela pipeline
#             (deploy/env/prod.env.tpl + render-env.sh) a partir dos GitHub
#             Secrets e reescrito a cada deploy.
#
# A "fiação" entre containers (BRAIN_BASE_URL, DB_PATH,
# PORT, PGVECTOR_URL, PG_URL) NÃO mora aqui: é environment fixo no
# docker-compose.yml.
# ==============================================================================

# --- Imagens (produção pina a tag; dev usa o default 'dev' com build) ---------
IMAGE_REPO=sofia-bot
IMAGE_TAG=dev
# Em produção o deploy grava: COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Cérebro: OpenRouter ------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-troque-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash
OPENROUTER_CLASSIFIER_MODEL=google/gemini-2.5-flash-lite
APP_REFERER=http://localhost:8000
APP_TITLE=Azapfy Suporte IA

# --- Cérebro: tuning ----------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=20
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
AGENT_MAX_ITERACOES=5
# Embeddings do índice pgvector: local (offline) | openrouter (mesma chave do
# LLM; produção usa openai/text-embedding-3-small). Trocar = reconstruir índice.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Postgres (pgvector): RAG do cérebro + estado do gateway ------------------
# Sobe no compose (serviço `pgvector`). A URL de conexão é fiação do compose;
# aqui só a senha (obrigatória — o compose recusa subir sem ela).
PGVECTOR_PASSWORD=troque-aqui
# Backend de LEITURA do RAG: chroma (dev local: exige `python -m src.rag.ingest`
# antes — a imagem docker NÃO embute índice) | pgvector (produção: índice
# populado pela ingestão do deploy/cron; em dev rode `python -m src.rag.sync`).
VECTOR_BACKEND=chroma

# --- Cérebro: fonte da base de conhecimento (AzapDocs, Contrato B) ------------
# `python -m src.rag.sync --fonte api` lê o inventário e os documentos daqui.
# A chave (azk_...) é gerada no AzapDocs (escopos DOCS_LIST + DOCS_READ).
DOCS_API_BASE_URL=https://intranet.azapfy.com.br/api/v1/integrations/docs
DOCS_API_KEY=
DOCS_API_TIMEOUT=30
# Webhook opcional (POST JSON {"text": ...}) avisado quando o sync diário
# falha. Vazio = só o journal da VM (journalctl -t azapfy-sync).
SYNC_ALERTA_WEBHOOK=

# --- Observabilidade (compartilhado: python aceita INFO, go aceita info) ------
LOG_LEVEL=info

# --- Gateway: Infodesk (docs/infodesk/) -------------------------------------
# Raiz da API de integração; a chave é o Bearer (escopos tickets:* e
# conversations:*). Em dev aponte para o mock: http://localhost:9000
INFODESK_BASE_URL=http://localhost:9000
INFODESK_API_KEY=troque-aqui
# HMAC-SHA256 do corpo cru do webhook (X-Infominas-Signature: sha256=...).
# Vazio = sem verificação (só dev). Opcionalmente também ?token=... na URL.
INFODESK_WEBHOOK_SECRET=
WEBHOOK_TOKEN=dev-token
# Se preenchido, webhook de outra organização é recusado (multi-tenant).
INFODESK_ORGANIZATION_ID=
INFODESK_TIMEOUT=15s
# Cache de mesas/departamentos/atendentes (GET /desks, /departments, /users).
REFERENCIA_CACHE_TTL=10m
# Departamento do Infodesk que recebe a conversa transferida pelo bot quando a
# taxonomia não aponta outro. Vazio = avisa o cliente e registra, mas não move.
DEPARTAMENTO_HUMANO_PADRAO=
PUBLIC_BASE_URL=

# --- Gateway: robustez de transporte (Bloco A) --------------------------------
DEBOUNCE_JANELA=8s
DEBOUNCE_TETO=20s
EVENTO_IDADE_MAX=10m
REPLY_MAX_CHARS=900
# Ordem dos prazos (checada no boot do gateway e do cérebro):
#   TURNO_TETO (105s) >= DEBOUNCE_TETO (20s) + BRAIN_TIMEOUT (80s)   [gateway]
#   BRAIN_TIMEOUT (80s) > BRAIN_TURNO_PRAZO (70s)
#   > INFODESK_TOOLS_TIMEOUT (30s) + folga do JEV.                    [cérebro]
BRAIN_TIMEOUT=80s

# --- Tools (/tools/infodesk/*): segredo compartilhado cérebro↔gateway --------
# Segredo compartilhado cérebro↔gateway (X-Tools-Token) — os DOIS lados leem:
TOOLS_API_TOKEN=troque-aqui
SAC_TOOLS_TOKEN=troque-aqui
SAC_TOOLS_TIMEOUT=30

# --- Gateway: reconciliador (E3.3; todos hipóteses de trabalho configuráveis) --
# Liga o loop (feed GET /events, tickets pendentes, vigia, repetição de handoff).
RECONCILIA_ATIVO=true
# Espera entre ciclos do reconciliador (docs/infodesk/05, 5.5).
RECONCILIA_INTERVALO=60s
# 1ª execução sem cursor: descarta eventos mais velhos que isto.
RECONCILIA_RETROATIVO=1h
# O cursor persistido anda este tempo atrás do relógio (recupera o que a fila perdeu num crash).
RECONCILIA_ATRASO=2m
# Teto da espera após RATE_LIMITED e entre repetições de um handoff que falhou.
RECONCILIA_BACKOFF_MAX=5m
# Tolerância entre o relógio do Infodesk e o nosso ao decidir "mensagem sem resposta".
RECONCILIA_SKEW=60s
# Conversa do bot sem resposta há mais que isto vai a um atendente (07 N1).
BOT_TIMEOUT_HANDOFF=5m
# Prazo para um ticket `pendente` aparecer na listagem do Infodesk antes de virar `falha`.
TICKET_PENDENTE_TTL=10m

# --- Gateway: chamados e identificação (E3.1) ---------------------------------
# `finish` do POST /conversations/:id/ticket: true encerra a conversa ao abrir o chamado (07 C6).
TICKET_FINISH_CONVERSA=false
# Anexa o rodapé "[Aberto pela Sofia · …]" à descrição do chamado (07 T8).
TICKET_RODAPE=true
# Depois do chamado aberto a conversa vai a um atendente (handoff).
TRANSFERIR_APOS_TICKET=true
# Mesma categoria + mesmo telefone dentro desta janela conta como chamado já aberto.
TICKET_DEDUP_JANELA=24h
# Consulta no Infodesk os chamados abertos do telefone antes de abrir outro (07 T5).
DEDUP_CONSULTA_INFODESK=true
# Formato aceito de número de contrato informado pelo cliente (regex).
# Default: 4 a 12 dígitos. Fica comentada porque a regex tem barra invertida e
# cifrão, que o shell e o compose reinterpretam; se mudar, use aspas simples.
# IDENT_CONTRATO_RE='^\d{4,12}$'
# Telefone reconhecido pelo Infodesk dispensa CPF/contrato (false, default). true = o
# lookup não basta e o CPF/contrato volta a ser exigido (gateway e cérebro leem).
# IDENT_EXIGIR_CPF=false
# Sal do hash de CPF/contrato. Vazio = usa o TOOLS_API_TOKEN, e rotacionar o token invalida os hashes: defina um sal próprio.
IDENT_HASH_SAL=
# Divergência entre a taxonomia e o Infodesk derruba o boot (false = só alerta).
STRICT_TAXONOMIA=false
# Arquivo da taxonomia; vazio = config/taxonomia.yaml (volume do compose) ou ../agente-ia/config/taxonomia.yaml.
TAXONOMIA_PATH=

# --- Gateway: lista de testadores (E3.9; homologação em produção) -------------
# Telefones E.164 separados por vírgula (com ou sem +55, com ou sem o 9º dígito).
# VAZIO = desligada: todo cliente fala com a Sofia. Preenchida: SÓ esses números
# falam com ela; os demais vão direto a um atendente (handoff para
# DEPARTAMENTO_HUMANO_PADRAO), sem resposta ao cliente. Com a flag "Conduz o
# atendimento" da chave ligada e esta lista VAZIA, todos os clientes caem na Sofia.
# Item que não é telefone derruba o boot. Ver docs/plano/operacao.md.
TESTADORES_TELEFONES=

# --- Cérebro: resiliência a falhas (lote ZC) ---------------------------------
# Teto de tokens de SAÍDA por chamada ao OpenRouter. Sem teto, o OpenRouter
# reserva 65.536 tokens por chamada e devolve 402 quando o saldo não cobre a
# reserva. Agente: 1024 (respostas curtas + tool calls); classificador e
# extrator de login (mesmo cliente): 256.
LLM_MAX_TOKENS=1024
LLM_MAX_TOKENS_CLASSIFICADOR=256
# Prazo TOTAL do turno no cérebro (s): menor que BRAIN_TIMEOUT (80s) e que
# TURNO_TETO (105s) — o cérebro desiste primeiro e devolve falha classificada.
# O gateway não conhece esta variável: mantenha-a abaixo de BRAIN_TIMEOUT.
BRAIN_TURNO_PRAZO=70
# Teto do turno desde a mensagem do cliente (coalescência + cérebro + novas
# tentativas em falha transitória: 2 s e 5 s). Falha definitiva não repete.
TURNO_TETO=105s
# Alertas ao responsável (falha definitiva, >5% de turnos com falha em 15 min,
# disjuntor aberto): sempre no log `sofia_alerta`; opcionalmente POST JSON
# {"text": ...} nesta URL (vazio = só log).
ALERTA_WEBHOOK_URL=
