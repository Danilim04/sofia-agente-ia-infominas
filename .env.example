# ==============================================================================
# .env ÚNICO da stack docker (raiz do repositório) — alimenta gateway + cérebro
# via docker-compose.yml.
#
#   cp .env.example .env     e preencha as linhas marcadas abaixo.
#
# NENHUM segredo vai neste arquivo, nem no git: segredos ficam vazios aqui e
# são preenchidos só no .env do host (que o .gitignore exclui). Gere segredos
# próprios com `openssl rand -hex 32`. Quem guarda o .env em produção é a
# Infominas (P10) — ver deploy/README.md.
#
# O arquivo deve citar TODA variável lida por backend/internal/config,
# backend/internal/taxonomia e agente-ia/src (e só elas): deploy/checar-env.py
# confere isso, e tanto faz a linha estar ativa ou comentada ("# NOME=valor").
#
# ------------------------------------------------------------------------------
# O QUE É OBRIGATÓRIO EM PRODUÇÃO
#
#   OBR = sem ela a stack não sobe ou não atende
#   REC = sobe, mas degradada ou sem proteção; preencha em produção
#   —   = tem default seguro; só mude com motivo
#
# | Variável                  | Em prod | O que acontece sem ela                                              |
# |---------------------------|---------|---------------------------------------------------------------------|
# | PGVECTOR_PASSWORD         | OBR     | o compose recusa subir; alfanumérica (entra numa URL)               |
# | INFODESK_BASE_URL         | OBR     | gateway não sobe (docs/infodesk/10 §1: https://infodesk.infominas.net/v1) |
# | INFODESK_API_KEY          | OBR     | gateway não sobe (chave `ik_live_…`, criada no painel do Desk)      |
# | INFODESK_WEBHOOK_SECRET   | OBR     | o gateway não sobe (`whsec_…`, mostrado 1 vez; ≥ 32 caracteres)    |
# | TOOLS_API_TOKEN           | OBR     | /tools/infodesk/* desligada: a Sofia não consegue abrir chamado     |
# | OPENROUTER_API_KEY        | OBR     | cérebro sobe e responde /health, mas todo turno com LLM falha       |
# | TYPESAFE_API_KEY          | REC     | sem JEV (P8): toda classificação cai no fallback LLM                |
# | IDENT_HASH_SAL            | REC     | sal do hash de CPF/contrato cai no TOOLS_API_TOKEN (rotacionar invalida) |
# | DEPARTAMENTO_HUMANO_PADRAO| REC     | transferência avisa o cliente mas não move a conversa               |
# | INFODESK_ORGANIZATION_ID  | REC     | webhook de outra organização não é recusado                         |
# | STRICT_TAXONOMIA=true     | REC     | divergência taxonomia × Infodesk só gera alerta (ligar após P1/E5.1)|
# | ALERTA_WEBHOOK_URL        | REC     | alertas só no log `sofia_alerta`                                    |
# | PUBLIC_BASE_URL           | REC     | só afeta a URL do webhook mostrada no log do boot                   |
# | LANGFUSE_*                | —       | tracing desligado                                                   |
#
# Fiação do compose (NÃO ponha no .env; o docker-compose.yml fixa e vence):
# PORT, BRAIN_BASE_URL, PG_URL, DB_PATH, PGVECTOR_URL, INFODESK_TOOLS_BASE_URL,
# INFODESK_TOOLS_TOKEN (= TOOLS_API_TOKEN), TAXONOMIA_PATH, CHROMA_PERSIST_DIR,
# DOCS_DIR, CHECKPOINT_DB_PATH, VECTOR_BACKEND (=pgvector). Aparecem comentadas abaixo só para documentar.
# ==============================================================================

# --- Compose: imagens e volume de config --------------------------------------
# Imagens: sofia-bot:brain-<tag> e sofia-bot:gateway-<tag>. Em dev, tag `dev`
# com build local; em produção use UMA TAG POR VERSÃO (ex.: v1.0.0): com `dev`
# o build sobrescreve a imagem anterior e não há rollback.
IMAGE_REPO=sofia-bot
IMAGE_TAG=dev
# Produção: COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Pasta montada em /config nos dois serviços (taxonomia.yaml). Default = a do repo.
# CONFIG_DIR=./agente-ia/config

# --- Postgres (pgvector): RAG do cérebro + estado do gateway ------------------
# OBR em prod. Sobe no compose (serviço `pgvector`); a URL de conexão é fiação.
PGVECTOR_PASSWORD=
# PGVECTOR_URL=postgresql://rag:<senha>@pgvector:5432/rag
# PG_URL=postgresql://rag:<senha>@pgvector:5432/rag
# DB_PATH=/data/gateway.db

# --- Gateway: Infodesk (docs/infodesk/01 e 10) --------------------------------
# Raiz da API de integração; aceita com ou sem /integration/v1. Em dev contra o
# mock: http://localhost:9000 (mock-infodesk, scripts/start-all.sh).
INFODESK_BASE_URL=https://infodesk.infominas.net/v1
# Bearer da chave `ik_live_…` (escopos mínimos em docs/infodesk/01; "Conduz o
# atendimento" ligado). OBR.
INFODESK_API_KEY=
# `whsec_…`: HMAC-SHA256 de "<X-Infominas-Timestamp>.<corpo>" no header
# X-Infominas-Signature. Mínimo de 32 caracteres fora do dev. Vazio: o gateway NÃO
# sobe (só com WEBHOOK_SEM_AUTENTICACAO=true, abaixo, em dev). OBR em prod.
INFODESK_WEBHOOK_SECRET=
# Segredo opcional EXTRA na query da URL cadastrada (…/webhook?token=…).
WEBHOOK_TOKEN=
# Tolerância entre o timestamp do webhook e o relógio local (anti-replay).
# WEBHOOK_JANELA=5m
# `organizationId` esperado (GET /me); preenchido, webhook de outra org é recusado.
INFODESK_ORGANIZATION_ID=
# Nome da chave = senderName das nossas mensagens. Vazio = o `name` de GET /me.
# INFODESK_NOME_CHAVE=
INFODESK_TIMEOUT=15s
# Cache de mesas/departamentos/atendentes (GET /desks, /departments, /users).
REFERENCIA_CACHE_TTL=10m
# Departamento do Infodesk que recebe a conversa transferida pelo bot quando a
# taxonomia não aponta outro. Vazio = avisa o cliente e registra, mas não move.
DEPARTAMENTO_HUMANO_PADRAO=
# URL pública (https, sem barra final) só para o gateway logar a URL do webhook.
PUBLIC_BASE_URL=
# PORT=8080
LOG_LEVEL=info

# --- Gateway: robustez de transporte ------------------------------------------
DEBOUNCE_JANELA=8s
DEBOUNCE_TETO=20s
EVENTO_IDADE_MAX=10m
REPLY_MAX_CHARS=900
# Pausa entre bolhas consecutivas do mesmo turno (ritmo humano).
# BOLHA_PAUSA=1500ms
# Ordem dos prazos (checada no boot do gateway e do cérebro):
#   TURNO_TETO (105s) >= DEBOUNCE_TETO (20s) + BRAIN_TIMEOUT (80s)   [gateway]
#   BRAIN_TIMEOUT (80s) > BRAIN_TURNO_PRAZO (70s)
#   > INFODESK_TOOLS_TIMEOUT (30s) + folga do JEV.                    [cérebro]
BRAIN_TIMEOUT=80s
# BRAIN_BASE_URL=http://brain:8001
# Teto do turno desde a mensagem do cliente (coalescência + cérebro + novas
# tentativas em falha transitória: 2 s e 5 s). Falha definitiva não repete.
TURNO_TETO=105s

# --- Tools (/tools/infodesk/*): segredo compartilhado cérebro↔gateway ---------
# O compose repassa este valor ao cérebro como INFODESK_TOOLS_TOKEN (X-Tools-Token).
# Mínimo de 32 caracteres fora do dev (ex.: openssl rand -hex 32).
TOOLS_API_TOKEN=
# Tools do cérebro: URL (fiação) e prazo por chamada ao gateway, em segundos.
# INFODESK_TOOLS_BASE_URL=http://gateway:8080
# INFODESK_TOOLS_TOKEN=
# INFODESK_TOOLS_TIMEOUT=30

# --- Gateway: reconciliador (hipóteses de trabalho configuráveis) -------------
# Liga o loop (feed GET /events, tickets pendentes, vigia, repetição de handoff).
RECONCILIA_ATIVO=true
# Espera entre ciclos do reconciliador (docs/infodesk/05, 5.5).
RECONCILIA_INTERVALO=60s
# 1ª execução sem cursor: descarta eventos mais velhos que isto.
RECONCILIA_RETROATIVO=1h
# O cursor persistido anda este tempo atrás do relógio (recupera o que a fila perdeu num crash).
RECONCILIA_ATRASO=2m
# Teto da espera após RATE_LIMITED e entre repetições de um handoff que falhou.
RECONCILIA_BACKOFF_MAX=5m
# Tolerância entre o relógio do Infodesk e o nosso ao decidir "mensagem sem resposta".
RECONCILIA_SKEW=60s
# Conversa do bot sem resposta há mais que isto vai a um atendente (07 N1).
BOT_TIMEOUT_HANDOFF=5m
# Prazo para um ticket `pendente` aparecer na listagem do Infodesk antes de virar `falha`.
TICKET_PENDENTE_TTL=10m

# --- Gateway: chamados e identificação ----------------------------------------
# `finish` do POST /conversations/:id/ticket: true encerra a conversa ao abrir o chamado (07 C6).
TICKET_FINISH_CONVERSA=false
# Anexa o rodapé "[Aberto pela Sofia · …]" à descrição do chamado (07 T8).
TICKET_RODAPE=true
# Depois do chamado aberto a conversa vai a um atendente (handoff).
TRANSFERIR_APOS_TICKET=true
# Mesma categoria + mesmo telefone dentro desta janela conta como chamado já aberto.
TICKET_DEDUP_JANELA=24h
# Consulta no Infodesk os chamados abertos do telefone antes de abrir outro (07 T5).
DEDUP_CONSULTA_INFODESK=true
# Telefone reconhecido pelo lookup dispensa CPF (false); true = sempre pede (07 N3).
# Os DOIS lados (gateway e cérebro) leem IDENT_EXIGIR_CPF e IDENT_CONTRATO_RE.
# IDENT_EXIGIR_CPF=false
# O que fazer com lookup ambíguo (mais de um solicitante). Único valor: pedir_cpf.
# IDENT_LOOKUP_AMBIGUO=pedir_cpf
# Validade do cache de identificação por telefone.
# IDENT_TTL=24h
# Formato aceito de número de contrato (regex). Default: 4 a 12 dígitos. Fica
# comentada porque a regex tem barra invertida e cifrão, que o shell e o compose
# reinterpretam; se mudar, use aspas simples.
# IDENT_CONTRATO_RE='^\d{4,12}$'
# Sal do hash de CPF/contrato. Vazio = usa o TOOLS_API_TOKEN, e rotacionar o
# token invalida os hashes: defina um sal próprio em produção.
IDENT_HASH_SAL=
# Divergência entre a taxonomia e o Infodesk derruba o boot (false = só alerta).
# Em produção, true depois que a taxonomia real entrar (P1 / E5.1).
STRICT_TAXONOMIA=false
# Cadastro de solicitante pela Sofia (E5.3, ADR 0009; hipóteses, TODO(decisão do produto)).
# Empresa não achada/ambígua depois das tentativas: transferir (handoff com nota por
# código) ou oferecer (só orienta o cliente a falar com um atendente).
# CADASTRO_SEM_CLIENTE=transferir
# Falhas de empresa (não achada/ambígua) por conversa antes de desistir (1 a 10).
# CADASTRO_MAX_TENTATIVAS=2
# Arquivo da taxonomia. No compose é fiação (/config/taxonomia.yaml); fora dele,
# vazio = config/taxonomia.yaml ou ../agente-ia/config/taxonomia.yaml.
# TAXONOMIA_PATH=

# --- Gateway: lista de testadores (E3.9; homologação em produção) -------------
# Telefones E.164 separados por vírgula (com ou sem +55, com ou sem o 9º dígito).
# VAZIO = desligada: todo cliente fala com a Sofia. Preenchida: SÓ esses números
# falam com ela; os demais vão direto a um atendente (handoff para
# DEPARTAMENTO_HUMANO_PADRAO), sem resposta ao cliente. Com a flag "Conduz o
# atendimento" da chave ligada e esta lista VAZIA, todos os clientes caem na Sofia.
# Item que não é telefone derruba o boot. Ver docs/plano/operacao.md.
TESTADORES_TELEFONES=
# Opt-in EXPLÍCITO para atender todo cliente: lista vazia só sobe com
# SOFIA_PRODUCAO_ABERTA=true (e o gateway alerta no boot). Em dev (Infodesk local)
# não é exigido. Preenchida a lista, esta variável é desnecessária.
SOFIA_PRODUCAO_ABERTA=false
# Só dev: deixa o gateway subir sem INFODESK_WEBHOOK_SECRET (webhook sem HMAC).
WEBHOOK_SEM_AUTENTICACAO=false

# --- Gateway: horário de atendimento humano (E5.5; hipótese de trabalho, P7) --
# Fora do horário a Sofia segue atendendo e abrindo chamado; só a transferência
# muda: o handoff continua (a conversa cai na fila) e o aviso ao cliente diz que a
# equipe atende no horário abaixo e que a conversa fica registrada. Formato: dias +
# faixas, várias entradas separadas por `;` (ex.: "seg-sex 08:00-18:00; sab 08:00-12:00";
# várias faixas no dia: "seg-sex 08:00-12:00,14:00-18:00"; fim menor que o início
# atravessa a meia-noite). Default = expediente das mesas do Desk (em dev, com o Infodesk
# local, a variável ausente = sempre dentro). VAZIO (HORARIO_HUMANO=)
# = sempre dentro do horário. TODO(P7): confirmar que vale para o WhatsApp.
HORARIO_HUMANO="seg-sex 08:00-18:00"
# Fuso do horário e dos feriados (nome IANA).
HORARIO_FUSO=America/Sao_Paulo
# Feriados (AAAA-MM-DD, separados por vírgula): nenhuma faixa COMEÇA no feriado (a
# continuação, depois da meia-noite, de uma faixa que começou no dia anterior segue valendo).
FERIADOS=
# avisar (default): fora do horário o aviso ao cliente é o de fora do horário.
# ignorar: aviso normal (a nota do handoff e o log seguem marcados "fora do horário").
FORA_DO_HORARIO_MODO=avisar

# --- Gateway: limites de abuso (E4.5; defaults folgados) ----------------------
# Teto de caracteres do texto coalescido de uma rajada que vai ao cérebro.
LOTE_MAX_CHARS=4000
# Turnos por telefone por hora; acima disso a conversa vai a um atendente.
TURNOS_POR_HORA_MAX=60

# --- Alertas ao responsável ----------------------------------------------------
# Falha definitiva, >5% de turnos com falha em 15 min, disjuntor aberto: sempre no
# log `sofia_alerta`; opcionalmente POST JSON {"text": ...} nesta URL.
ALERTA_WEBHOOK_URL=

# --- Cérebro: OpenRouter (LLM) -------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash
OPENROUTER_CLASSIFIER_MODEL=google/gemini-2.5-flash-lite
APP_REFERER=http://localhost:8000
APP_TITLE=Sofia — Infominas

# --- Cérebro: tuning do LLM ----------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=20
# Teto de tokens de SAÍDA por chamada. Sem teto, o OpenRouter reserva 65.536
# tokens por chamada e devolve 402 quando o saldo não cobre a reserva.
LLM_MAX_TOKENS=1024
LLM_MAX_TOKENS_CLASSIFICADOR=256
# Prazo TOTAL do turno no cérebro (s): menor que BRAIN_TIMEOUT (80s) e que
# TURNO_TETO (105s) — o cérebro desiste primeiro e devolve falha classificada.
# O gateway não conhece esta variável: mantenha-a abaixo de BRAIN_TIMEOUT.
BRAIN_TURNO_PRAZO=70
AGENT_MAX_ITERACOES=5

# --- Cérebro: classificação JEV (TypeSafe; docs/plano/02-classificacao.md) ----
# Chave do serviço (REC em prod; P8). Vazia = só fallback LLM.
TYPESAFE_API_KEY=
# Modelo PINADO: os limiares foram calibrados para ele. Todos abaixo são
# hipóteses de trabalho com default no código; descomente só para ajustar.
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT=2.0
# JEV_MAX_RETRIES=2
# JEV_PRAZO_TOTAL=6.0
# JEV_DISJUNTOR_FALHAS=5
# JEV_DISJUNTOR_PAUSA=30.0
# JEV_ALERTA_INDISPONIVEL=0.05
# JEV_ALERTA_JANELA_S=900.0
# JEV_JANELA_MSGS=6
# JEV_MAX_TOKENS_ESTADO=2000
# JEV_LIMIAR_INTENCAO_ALTO=0.70
# JEV_LIMIAR_INTENCAO_BAIXO=0.45
# JEV_LIMIAR_CATEGORIA_ALTO=0.65
# JEV_LIMIAR_CATEGORIA_BAIXO=0.40
# JEV_LIMIAR_CATEGORIA_TROCA=0.85
# JEV_LIMIAR_PRIORIDADE=0.60
# JEV_LIMIAR_FRUSTRACAO_SCORE=3
# JEV_LIMIAR_FRUSTRACAO_CONFIANCA=0.60
# JEV_LIMIAR_FRUSTRACAO_CUIDADO=2
# JEV_LIMIAR_MALICIOSO_BLOQUEIO=0.80
# JEV_LIMIAR_MALICIOSO_AVISO=0.50
# JEV_LIMIAR_FORA_ESCOPO=0.80
# JEV_LIMIAR_PEDIR_ATENDENTE=0.60
# JEV_MAX_ESCLARECIMENTOS=1
# transferir | triagem (TODO(P11): decidir com a Infominas)
# JEV_ACAO_INDEFINIDA=transferir
# JEV_FALLBACK_FIXA_SEM_JEV=true
# JEV_PRIORIDADE_SO_SOBE=true

# --- Cérebro: RAG (base de conhecimento) ---------------------------------------
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Backend de LEITURA: chroma (só dev fora do docker; exige `python -m src.rag.ingest`)
# | pgvector. No compose é fiação e vale sempre pgvector (a imagem não embute
# índice); popule-o com `docker compose run --rm brain python -m src.rag.sync`
# (deploy/README.md).
# VECTOR_BACKEND=pgvector
# Embeddings do índice pgvector: local (offline) | openrouter (mesma chave do
# LLM; ex.: openai/text-embedding-3-small). Trocar = reconstruir o índice.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Trava anti-remoção em massa do sync (fração da base viva por ciclo).
# SYNC_LIMIAR_REMOCAO=0.2
# Fonte da base de conhecimento da Infominas (API/portal; TODO(P6): stub).
# Vazio = o sync usa a fonte local (agente-ia/docs/base, já dentro da imagem).
DOCS_API_BASE_URL=
DOCS_API_KEY=
DOCS_API_TIMEOUT=30
# Fiação do compose (caminhos dentro da imagem).
# CHROMA_PERSIST_DIR=/app/chroma_db
# DOCS_DIR=/app/docs/base
# Histórico de conversa persistente (checkpointer SQLite) — volume brain-data.
# CHECKPOINT_DB_PATH=/data/checkpoints.db

# --- Observabilidade: Langfuse (tracing, opcional) ----------------------------
# Sem as duas chaves o tracing fica desligado. Host: cloud EU (default) ou US
# (https://us.cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
