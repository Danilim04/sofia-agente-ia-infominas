# =========================================================
# OpenRouter (LLM Provider via proxy unificado)
# Obtenha sua chave em: https://openrouter.ai/keys
# =========================================================
OPENROUTER_API_KEY=sk-or-v1-troque-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo principal do agente (suporta tool-calling)
# Default: google/gemini-3.5-flash (~$1,50/$9 por 1M; caching implícito do
# Gemini — cache_control explícito só é aplicado a modelos anthropic/).
# Alternativas: google/gemini-3.7-flash (~$0,38/$1,88, mais novo e barato),
# anthropic/claude-haiku-4.5 (~$1/$5, religa o cache_control).
OPENROUTER_MODEL=google/gemini-3.5-flash

# Modelo barato/rapido para o classificador de seguranca (fallback ate o JEV
# assumir a seguranca em E2.2)
# Default: google/gemini-2.5-flash-lite (~$0,10/$0,40). Alternativas: openai/gpt-4o-mini.
OPENROUTER_CLASSIFIER_MODEL=google/gemini-2.5-flash-lite

# Headers de boa cidadania exigidos/recomendados pelo OpenRouter
APP_REFERER=http://localhost:8000
APP_TITLE=Sofia — Infominas

# =========================================================
# RAG / ChromaDB (dev) e pgvector (producao)
# =========================================================
CHROMA_PERSIST_DIR=./chroma_db
DOCS_DIR=./docs

# Embeddings do indice pgvector: local (sentence-transformers, offline) ou
# openrouter (POST /embeddings com a mesma OPENROUTER_API_KEY; producao usa
# openai/text-embedding-3-small, multilingue, ~US$0,02 por 1M tokens).
# Trocar provider/modelo exige reconstruir o indice (sync --full).
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Producao:
# EMBEDDINGS_PROVIDER=openrouter
# EMBEDDINGS_MODEL=openai/text-embedding-3-small

# Backend de LEITURA do RAG: chroma (so dev, default) | pgvector (producao).
# O sync (python -m src.rag.sync) sempre grava no pgvector; esta chave decide
# de onde o agente le.
VECTOR_BACKEND=chroma
# Ex.: postgresql://rag:senha@localhost:5433/rag
PGVECTOR_URL=

# Fonte do sync: por enquanto so `--fonte local` (docs/*.md). A API/portal de
# documentos da Infominas (pendencia P6) entra em E3.2 com suas proprias
# variaveis DOCS_API_*.

# Trava anti-remocao em massa do sync (fracao da base viva por ciclo).
SYNC_LIMIAR_REMOCAO=0.2

# =========================================================
# Observabilidade
# =========================================================
# Nivel de log do cerebro (DEBUG|INFO|WARNING|ERROR). Use DEBUG para ver a
# query do RAG, os tool_calls do agente, o uso de tokens e a resposta completa.
LOG_LEVEL=INFO

# --- Langfuse (tracing) — OPCIONAL --------------------------------------------
# Sem as duas chaves, o tracing fica desligado e o agente roda normal.
# Crie um projeto em https://cloud.langfuse.com e cole as chaves aqui.
# Host: https://cloud.langfuse.com (EU) ou https://us.cloud.langfuse.com (US).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =========================================================
# Tuning
# =========================================================
LLM_TEMPERATURE=0.2
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Timeout por chamada de LLM (s) — 2 chamadas por turno (+1 retry cada) tendem a
# caber no BRAIN_TURNO_PRAZO (70s), mas isso nao e validado no boot
LLM_TIMEOUT=20

# Teto de iteracoes do loop agent<->tools por turno (limite de guarda de custo)
AGENT_MAX_ITERACOES=5

# Checkpointer persistente do grafo (historico de conversa sobrevive a restart).
# Em docker o compose aponta para /data/checkpoints.db (volume brain-data).
CHECKPOINT_DB_PATH=./data/checkpoints.db

# =========================================================
# Tools do Infodesk (identificar, chamados, transferir) — moram no gateway Go
# =========================================================
# URL do gateway Go que expoe /tools/infodesk/*. INFODESK_TOOLS_TOKEN tem que
# casar com o TOOLS_API_TOKEN do backend Go (header X-Tools-Token).
INFODESK_TOOLS_BASE_URL=http://localhost:8080
INFODESK_TOOLS_TOKEN=
# O MESMO segredo protege /chat e /encerrar-episodio deste cerebro: o gateway manda o
# header X-Brain-Token (= TOOLS_API_TOKEN) e o cerebro recusa com 401 sem ele. Com o
# token vazio o cerebro fica aberto (so dev local; avisa no log).
INFODESK_TOOLS_TIMEOUT=30

# =========================================================
# Resiliencia a falhas
# =========================================================
# Teto de tokens de SAIDA por chamada. Sem teto o OpenRouter reserva 65.536
# tokens por chamada e devolve 402 quando o saldo nao cobre a reserva.
# Agente: 1024; classificador: 256.
LLM_MAX_TOKENS=1024
LLM_MAX_TOKENS_CLASSIFICADOR=256
# Prazo TOTAL do turno no cerebro (s). Ordem checada no boot (E3.7):
#   TURNO_TETO (105s) >= DEBOUNCE_TETO (20s) + BRAIN_TIMEOUT (80s)  [conferido no gateway]
#   BRAIN_TIMEOUT (80s) > BRAIN_TURNO_PRAZO (70s)
#   > INFODESK_TOOLS_TIMEOUT (30s) + folga do JEV.
# Se BRAIN_TIMEOUT/TURNO_TETO do gateway estiverem neste ambiente, o cerebro
# confere a cadeia inteira; sem elas, confere so a parte dele. Valida-se o piso
# da tool mais lenta (abrir_chamado espera ate 35s) + JEV; as chamadas de LLM
# (LLM_TIMEOUT, ate 2 por turno, 1 retry cada) nao entram na conta.
BRAIN_TURNO_PRAZO=70
# BRAIN_TIMEOUT=80s
# TURNO_TETO=105s

# =========================================================
# Identificacao do cliente (mesmas variaveis do gateway Go)
# =========================================================
# Telefone reconhecido pelo lookup do Infodesk dispensa CPF/contrato (false,
# default). true = o lookup nao basta e informar_identificacao volta a ser
# obrigatoria antes de preparar o chamado.
IDENT_EXIGIR_CPF=false
# Formato aceito de numero de contrato (regex; default 4 a 12 digitos). Use aspas
# simples: a regex tem barra invertida e cifrao.
# IDENT_CONTRATO_RE='^\d{4,12}$'
